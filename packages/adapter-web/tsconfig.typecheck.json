{
  // Typecheck-only config (no emit), covering the tests as well as src.
  //
  // It maps @hearth/probe-core straight at that package's sources, so
  // checking here never waits on probe-core being installed and built first.
  // `rootDir` is widened purely because that mapping pulls in files outside
  // src — nothing is emitted, so it has no effect on the build
  // (`tsconfig.json`, which stays the standard package shape).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@hearth/probe-core": ["../probe-core/src/index.js"]
    }
  },
  "include": ["src", "tests"]
}
