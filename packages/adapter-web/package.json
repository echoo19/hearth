{
  "name": "@hearth/adapter-web",
  "version": "1.4.0",
  "description": "Hearth probe adapter for local web games: GameUnderTest over Chrome DevTools Protocol, with an optional in-game shim for deeper senses",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shim": "./shim/probe-shim.js"
  },
  "files": [
    "dist",
    "shim",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hearth/probe-core": "*"
  },
  "optionalDependencies": {
    "playwright-core": "^1.61.1"
  }
}
