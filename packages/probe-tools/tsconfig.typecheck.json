{
  // Typecheck-only config (no emit), covering the tests as well as src.
  //
  // It maps @hearth/probe-core and @hearth/adapter-web straight at those
  // packages' sources — the same trick as packages/adapter-web's own
  // tsconfig.typecheck.json — so checking here never waits on those packages
  // being installed and built first. `rootDir` is widened purely because that
  // mapping pulls in files outside src; nothing is emitted, so it has no
  // effect on the build (tsconfig.json, which stays the standard shape).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@hearth/probe-core": ["../probe-core/src/index.js"],
      "@hearth/adapter-web": ["../adapter-web/src/index.js"]
    }
  },
  "include": ["src", "tests"]
}
